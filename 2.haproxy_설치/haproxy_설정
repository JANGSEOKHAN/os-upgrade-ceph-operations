3. systemd 유닛 파일 (/etc/systemd/system/haproxy.service)

sudo vi /etc/systemd/system/haproxy.service
[Unit]
Description=HAProxy Load Balancer
After=network.target

[Service]
ExecStart=/usr/local/sbin/haproxy -Ws -f /etc/haproxy/haproxy.cfg -p /var/run/haproxy.pid
ExecReload=/usr/local/sbin/haproxy -f /etc/haproxy/haproxy.cfg -c -q
Restart=always

[Install]
WantedBy=multi-user.target
------------------------------------------------------------------------------------------------
4. 실행 방법
# 유닛 반영
sudo systemctl daemon-reload
# 자동시작 등록
sudo systemctl enable haproxy
# 즉시 실행
sudo systemctl start haproxy
# 상태 확인
sudo systemctl status haproxy
