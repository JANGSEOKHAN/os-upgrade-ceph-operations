# TCP 연결 유지 시간 (초) - 비활성 연결을 유지할 시간 설정
net.ipv4.tcp_keepalive_time=160

# IP 포워딩 비활성화 (패킷 라우팅 비허용)
net.ipv4.ip_forward=0

# 기본 인터페이스의 Reverse Path 필터링 설정 (2: loose 모드)
net.ipv4.conf.default.rp_filter=2

# 모든 인터페이스의 Reverse Path 필터링 설정 (2: loose 모드)
net.ipv4.conf.all.rp_filter=2

# 기본 인터페이스에서 source routing 비허용
net.ipv4.conf.default.accept_source_route=0

# SYN Flood 방어 활성화
net.ipv4.tcp_syncookies=1

# 커널이 여유 메모리로 유지할 최소 페이지 수 (kB 단위) → 512MB
vm.min_free_kbytes=524288

# ------------------------
# NMI (Non-Maskable Interrupt) 관련 커널 패닉 설정
# ------------------------

# 커널 패닉 시 자동 재부팅 활성화
kernel.panic=1

# I/O 오류 발생 시 NMI로 패닉
kernel.panic_on_io_nmi=1

# 복구 불가능한 NMI 발생 시 패닉
kernel.panic_on_unrecovered_nmi=1

# SysRq 키 활성화 (디버깅용 매직키 사용 허용)
kernel.sysrq=1

# 알 수 없는 NMI 발생 시 커널 패닉
kernel.unknown_nmi_panic=1

# 커널 Oops(심각 오류) 발생 시 패닉
kernel.panic_on_oops=1

# ------------------------
# 프로세스 Core Dump 설정
# ------------------------

# Core dump 파일 경로 패턴
kernel.core_pattern=/var/crash/core.%e.%p.%h.%t

# SUID 바이너리로부터 코어 덤프 허용
fs.suid_dumpable=1

# core dump 파일명에 PID 포함
kernel.core_uses_pid=1

# ------------------------
# PISA 및 네트워크 성능 튜닝
# ------------------------

# NIC에서 커널로 전달되는 패킷 큐 크기 (수신 backlog)
net.core.netdev_max_backlog=2048

# 연결 대기 큐 크기 설정 (서버 listen backlog)
net.core.somaxconn=2048

# TCP SYN 수신 대기 backlog 크기
net.ipv4.tcp_max_syn_backlog=2048

# NIC 수신 처리 시 1회 루프 내 최대 패킷 수
net.core.netdev_budget=600

# 로컬에 없는 IP에 대해서도 바인딩 허용 (VIP 등에서 사용)
net.ipv4.ip_nonlocal_bind=1

# [중복] 위의 ip_forward=0과 상충되므로 1로 설정하려면 기존 줄 삭제 필요
net.ipv4.ip_forward=1

#설정 명령어
sudo sysctl -p

#적용 확인
# 모든 항목 확인
sysctl -a

# 특정 항목만 확인
sysctl net.ipv4.ip_forward
sysctl vm.min_free_kbytes
sysctl kernel.panic_on_oops
